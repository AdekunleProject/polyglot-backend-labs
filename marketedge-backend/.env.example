# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Required. The app refuses to start without these three.
MONGODB_URI=mongodb://localhost:27017/marketedge
JWT_SECRET=change-me-use-at-least-32-random-characters
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Redis (cache, GraphQL subscriptions, SMS queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker compose only: database and cache passwords (generate random values)
MONGO_ROOT_USER=marketedge
MONGO_ROOT_PASSWORD=change-me
# first admin, created at start-up when no admin exists
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Social sign-in: the ID token's audience must match these
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Email (verification and password reset codes)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MarketEdge" <no-reply@marketedge.local>

# Comma-separated browser origins allowed by CORS. Empty = none in production.
CORS_ORIGIN=
