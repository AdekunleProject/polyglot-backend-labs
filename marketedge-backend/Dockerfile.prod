# Dockerfile.prod
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="\$PNPM_HOME:\$PATH"
RUN corepack enable
WORKDIR /usr/src/app
COPY package*.json pnpm-lock.yaml ./

# --- Stage 1: Build Source Engine ---
FROM base AS build-engine
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

# --- Stage 2: Minimal Runtime Layer ---
FROM base AS runtime-engine
RUN pnpm install --prod --frozen-lockfile
COPY --from=build-engine /usr/src/app/dist ./dist

USER node
EXPOSE 3000
CMD ["node", "dist/main"]
