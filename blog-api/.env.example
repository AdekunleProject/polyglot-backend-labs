# Copy this file to .env. For a local run with Docker, nothing below needs
# editing. NEVER reuse these example values anywhere public or real, and never
# commit a real .env.
NODE_ENV=development
PORT=3000

# Docker Compose overrides DB_HOST and DB_PORT with its own bundled PostgreSQL.
# Use your own values when running without Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog-local-password
DB_NAME=blog
# Set to true for managed databases that require TLS (Neon, Render, RDS...).
DB_SSL=false

# Apply pending migrations when the app starts.
RUN_MIGRATIONS=true

# Two different secrets: one signs access tokens, the other refresh tokens.
# Change both for anything that is not a throwaway local run (32+ characters
# are required in production). For example: openssl rand -hex 32
JWT_SECRET=local-dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-9876543210
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Browser origins allowed to call the API, comma separated. Empty = none.
# The first one is also where Google sign-in sends the user back to.
FRONTEND_URL=http://localhost:5173

# Behind a load balancer or ingress (Kubernetes, Render, Fly...), set to true.
TRUST_PROXY=false

# Per-client requests per minute across the API. Sign-in style routes have
# tighter limits of their own.
THROTTLE_LIMIT=60

# Share rate limit counters between replicas. Without it each instance counts
# alone. docker compose sets this for you. If Redis is down the API keeps
# working and counts in memory.
# REDIS_URL=redis://localhost:6379

# Key that encrypts authenticator secrets in the database. Optional: JWT_SECRET
# is used when it is not set. Changing it makes existing 2FA setups unusable.
# TWO_FACTOR_KEY=

# Swagger UI at /docs. On by default, except when NODE_ENV=production.
# Set true or false to override.
ENABLE_DOCS=true

# The superadmin, created at start (the only way to get one). The older
# ADMIN_EMAIL / ADMIN_PASSWORD names still work.
# SUPERADMIN_EMAIL=owner@example.com
# SUPERADMIN_PASSWORD=change-this-long-password
# Admins and superadmins must turn on 2FA before using the API. Default: true
# in production, false elsewhere.
# REQUIRE_ADMIN_2FA=true

# Email (verification and password reset codes). Without MAIL_HOST nothing is
# sent; outside production the message, code included, is printed in the log.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM="Blog <no-reply@example.com>"

# Profile pictures in S3. Without AWS_S3_BUCKET uploads answer 503. Leave the
# keys out on AWS (EKS, EC2) and use an IAM role instead. Never commit keys.
# AWS_REGION=eu-north-1
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Sign in with Google (all three, or none).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Reports, flags and the weekly digest
# REPORT_TZ_OFFSET_HOURS=1
# FLAG_DELETES=10
# FLAG_LOOKUPS=20
# OFF_HOURS_START=22
# OFF_HOURS_END=6
# WEEKLY_DIGEST=true
# DIGEST_DAY=1
# DIGEST_HOUR=8
