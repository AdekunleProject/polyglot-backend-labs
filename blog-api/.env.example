# Copy this file to .env. For a local run with Docker, nothing below needs
# editing. NEVER reuse these example values anywhere public or real.
NODE_ENV=development
PORT=3000

# Docker Compose overrides DB_HOST and DB_PORT with its own bundled PostgreSQL.
# Use your own values when running without Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog-local-password
DB_NAME=blog
# Set to true for managed databases that require TLS (Neon, Render, RDS...).
DB_SSL=false

# Apply pending migrations when the app starts.
RUN_MIGRATIONS=true

# Change this for anything that is not a throwaway local run (32+ characters
# are required in production). For example: openssl rand -hex 32
JWT_SECRET=local-dev-access-secret-change-me-0123456789
JWT_EXPIRES_IN=1h

# Browser origins allowed to call the API, comma separated. Empty = none.
FRONTEND_URL=http://localhost:5173
