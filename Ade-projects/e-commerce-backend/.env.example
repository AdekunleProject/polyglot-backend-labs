# Copy this file to .env. For a local run with Docker, nothing below needs
# editing. NEVER reuse these example values anywhere public or real.
NODE_ENV=development
PORT=5000

# Docker Compose overrides this with the bundled MongoDB replica set.
# Use your own replica set (for example MongoDB Atlas) when running without Docker.
MONGODB_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0

# Change both secrets for anything that is not a throwaway local run.
JWT_SECRET=local-dev-access-secret-change-me-0123456789
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-9876543210
JWT_REFRESH_EXPIRES_IN=7d

# Admin account created on first start. Choose your own password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Local-Only-123

FRONTEND_URL=http://localhost:5173
# Swagger UI at /docs. On unless NODE_ENV=production; set true or false to override.
ENABLE_DOCS=true

# Requests per minute per client address (auth routes have tighter limits).
# THROTTLE_LIMIT=60
# Behind a load balancer or ingress, set true so limits see the real client address.
# TRUST_PROXY=false

# Share rate limit counters between replicas. Without it each instance counts
# alone. docker compose sets this for you. If Redis is down the API keeps
# working and counts in memory.
# REDIS_URL=redis://localhost:6379

# Key that encrypts authenticator secrets in the database. Optional: JWT_SECRET
# is used when it is not set. Changing it makes existing 2FA setups unusable.
# TWO_FACTOR_KEY=

# Google sign-in. Placeholders let the app start; real login needs real values.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Paystack: use a TEST key (sk_test_...) only. Never put a live key in a file that is committed.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Image uploads (S3). Not needed for the demo data or for trying the API.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email. Leave MAIL_HOST empty and no email is sent: outside production the
# message (with its code) is printed in the log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
